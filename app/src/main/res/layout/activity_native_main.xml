<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/activity_root"
    android:background="@drawable/home_bkg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/focusable_view"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="0px"
                android:layout_height="0px"
                android:layout_weight="0"/>
            <FrameLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_gravity="center"
                    android:padding="20dp"
                    android:layout_width="516dp"
                    android:layout_height="133dp"
                    android:src="@drawable/roblox_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/empty"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0">
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5">
                    <Button
                        android:id="@+id/play_now"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/PlayNowButtonLabel"
                        android:onClick="onPlayNow"
                        style="@style/LoginButtonTheme"/>
                    <EditText
                        android:textColorHint="@color/shell_text_hint"
                        android:id="@+id/username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/empty"
                        android:hint="@string/UsernameWord"
                        android:inputType="textNoSuggestions"
                        android:imeOptions="actionNext"
                        android:onClick="onNop"/>
                    <EditText
                        android:textColorHint="@color/shell_text_hint"
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/empty"
                        android:hint="@string/PasswordWord"
                        android:inputType="textPassword"
                        android:imeOptions="actionGo"
                        android:onClick="onNop"/>
                    <CheckBox
                        android:id="@+id/remember_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/RememberPassword"
                        android:onClick="onRememberPassword"
                        android:contentDescription="@string/empty"
                        style="@style/LoginCheckboxTheme"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Button
                            android:gravity="center"
                            android:id="@+id/login"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/LoginWord"
                            android:onClick="onExecuteLogin"
                            style="@style/LoginButtonTheme"/>
                        <Button
                            android:gravity="center"
                            android:id="@+id/sign_up"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/SignupWord"
                            android:onClick="onSignUp"
                            style="@style/LoginButtonTheme"/>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false">
            <View
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="0px"
                android:layout_height="0px"/>
            <ViewFlipper
                android:id="@+id/sidebar_flipper"
                android:layout_width="250dp"
                android:layout_height="match_parent"
                android:layout_weight="0">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/lefthand_navigation_background2x"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_gravity="center"
                        android:paddingBottom="20dp"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:src="@drawable/crate"
                        android:layout_weight="0"
                        android:contentDescription="@string/empty"/>
                    <TextView
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/WelcomeToRoblox"
                        android:layout_weight="0"/>
                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/YouAreCurrentlyLoggedInAs"
                        android:layout_weight="0"/>
                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <Button
                        android:id="@+id/sidebar_sign_up"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="@string/SignupWord"
                        android:layout_weight="0"
                        style="@style/LoginButtonTheme"/>
                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="5dp"
                        android:layout_weight="0"/>
                    <Button
                        android:id="@+id/sidebar_login"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="@string/LoginWord"
                        android:layout_weight="0"
                        style="@style/LoginButtonTheme"/>
                </LinearLayout>
                <RelativeLayout
                    android:background="@drawable/lefthand_navigation_background2x"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:layout_gravity="left"
                            android:id="@+id/thumbnail_url"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/roblox_logo"
                            android:contentDescription="@string/empty"/>
                        <TextView
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:ellipsize="end"
                            android:layout_gravity="left"
                            android:id="@+id/username_textview"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/UsernameWord"
                            android:singleLine="true"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <ImageView
                                    android:layout_gravity="left"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:src="@drawable/robux_symbol2x"
                                    android:scaleType="fitCenter"
                                    android:contentDescription="@string/empty"/>
                                <com.roblox.roblox_client.AutoResizeTextView
                                    android:textSize="25sp"
                                    android:ellipsize="none"
                                    android:gravity="center"
                                    android:id="@+id/robux_balance"
                                    android:padding="4dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="25dp"
                                    android:text="@string/placeholder_number"
                                    android:singleLine="true"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <ImageView
                                    android:layout_gravity="left"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:src="@drawable/tix_symbol2x"
                                    android:scaleType="fitCenter"
                                    android:contentDescription="@string/empty"/>
                                <com.roblox.roblox_client.AutoResizeTextView
                                    android:textSize="25sp"
                                    android:ellipsize="none"
                                    android:gravity="center"
                                    android:id="@+id/tickets_balance"
                                    android:padding="4dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="25dp"
                                    android:text="@string/placeholder_number"
                                    android:singleLine="true"/>
                            </LinearLayout>
                        </LinearLayout>
                        <EditText
                            android:textSize="20sp"
                            android:textColorHint="@color/shell_text_hint"
                            android:id="@+id/search"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/empty"
                            android:hint="@string/SearchWord"
                            android:inputType="textNoSuggestions"
                            android:imeOptions="actionGo"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/logout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/logout2x"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentBottom="true"
                        android:contentDescription="@string/empty"/>
                </RelativeLayout>
            </ViewFlipper>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.1"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="0.1"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageButton
                        android:layout_gravity="center"
                        android:id="@+id/games"
                        android:background="@android:color/transparent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/games_button2x"
                        android:scaleType="centerInside"
                        android:onClick="onMainImageButton"
                        android:contentDescription="@string/GameWord"/>
                    <com.roblox.roblox_client.AutoResizeTextView
                        android:textSize="80sp"
                        android:ellipsize="none"
                        android:gravity="bottom|center_horizontal"
                        android:id="@+id/native_main_resize_text_1"
                        android:paddingBottom="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/GameWord"
                        android:singleLine="true"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="0.1"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageButton
                        android:layout_gravity="center"
                        android:id="@+id/builders_club"
                        android:background="@android:color/transparent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/builders_button_club2x"
                        android:scaleType="centerInside"
                        android:onClick="onMainImageButton"
                        android:contentDescription="@string/BuildersClubWord"/>
                    <com.roblox.roblox_client.AutoResizeTextView
                        android:textSize="80sp"
                        android:ellipsize="none"
                        android:gravity="bottom|center_horizontal"
                        android:id="@+id/native_main_resize_text_2"
                        android:paddingBottom="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/BuildersClubWord"
                        android:singleLine="true"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1.1"/>
            </LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="0.1"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="0.1"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageButton
                        android:layout_gravity="center"
                        android:id="@+id/catalog"
                        android:background="@android:color/transparent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/catalog_button2x"
                        android:scaleType="centerInside"
                        android:onClick="onMainImageButton"
                        android:contentDescription="@string/CatalogWord"/>
                    <com.roblox.roblox_client.AutoResizeTextView
                        android:textSize="80sp"
                        android:ellipsize="none"
                        android:gravity="bottom|center_horizontal"
                        android:id="@+id/native_main_resize_text_3"
                        android:paddingBottom="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/CatalogWord"
                        android:singleLine="true"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="0.1"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageButton
                        android:layout_gravity="center"
                        android:id="@+id/profile"
                        android:background="@android:color/transparent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/profile_button2x"
                        android:scaleType="centerInside"
                        android:onClick="onMainImageButton"
                        android:contentDescription="@string/ProfileWord"/>
                    <com.roblox.roblox_client.AutoResizeTextView
                        android:textSize="80sp"
                        android:ellipsize="none"
                        android:gravity="bottom|center_horizontal"
                        android:id="@+id/native_main_resize_text_4"
                        android:paddingBottom="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/ProfileWord"
                        android:singleLine="true"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1.1"/>
            </LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="0.1"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="0.1"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageButton
                        android:layout_gravity="center"
                        android:id="@+id/inventory"
                        android:background="@android:color/transparent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/inventory_button2x"
                        android:scaleType="centerInside"
                        android:onClick="onMainImageButton"
                        android:contentDescription="@string/InventoryWord"/>
                    <com.roblox.roblox_client.AutoResizeTextView
                        android:textSize="80sp"
                        android:ellipsize="none"
                        android:gravity="bottom|center_horizontal"
                        android:id="@+id/native_main_resize_text_5"
                        android:paddingBottom="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/InventoryWord"
                        android:singleLine="true"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="0.1"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageButton
                        android:layout_gravity="center"
                        android:id="@+id/messages"
                        android:background="@android:color/transparent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/messages_button2x"
                        android:scaleType="centerInside"
                        android:onClick="onMainImageButton"
                        android:contentDescription="@string/MessagesWord"/>
                    <com.roblox.roblox_client.AutoResizeTextView
                        android:textSize="80sp"
                        android:ellipsize="none"
                        android:gravity="bottom|center_horizontal"
                        android:id="@+id/native_main_resize_text_6"
                        android:paddingBottom="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/MessagesWord"
                        android:singleLine="true"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.1">
                    <ImageButton
                        android:id="@+id/about_button"
                        android:background="@android:color/transparent"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="20dp"
                        android:src="@drawable/about_icon"
                        android:scaleType="centerInside"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentBottom="true"
                        android:onClick="onAbout"
                        android:contentDescription="@string/empty"/>
                </RelativeLayout>
            </LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="0.1"/>
        </LinearLayout>
    </ViewFlipper>
</FrameLayout>
