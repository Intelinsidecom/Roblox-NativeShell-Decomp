<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/native_sidebar_page_background"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="40sp"
            android:textColor="@color/native_sidebar_page_heading"
            android:layout_gravity="left"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/GameWord"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/native_sidebar_page_heading"
            android:layout_gravity="left"
            android:id="@+id/games_page_status"
            android:paddingLeft="20dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty"
            android:layout_weight="0"/>
    </LinearLayout>
    <com.roblox.roblox_client.ListViewInfinite
        android:orientation="vertical"
        android:id="@+id/games_page_listview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="@android:color/transparent"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:layout_weight="1"/>
</LinearLayout>
