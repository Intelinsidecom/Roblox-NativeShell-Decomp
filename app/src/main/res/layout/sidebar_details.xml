<?xml version="1.0" encoding="utf-8"?>
<com.roblox.roblox_client.SidebarLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false">
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.5"/>
    <ImageView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:src="@drawable/sb_bullet"
        android:layout_weight="1"
        android:contentDescription="@string/empty"/>
    <TextView
        android:textSize="25sp"
        android:layout_gravity="left"
        android:id="@+id/sidebar_detail_label"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/empty"
        android:layout_weight="4.5"/>
</com.roblox.roblox_client.SidebarLinearLayout>
